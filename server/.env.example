# Servidor
PORT=4000
NODE_ENV=development

# Cadena secreta para firmar los JWT. CÁMBIALA en producción.
JWT_SECRET=cellbits_dev_secret_change_me
JWT_EXPIRES_IN=12h

# Usuario admin creado en el seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Dominio/servidor donde esta publicada la plataforma.
# Se usa para construir la URL embebida en el codigo QR (ej: http://192.168.1.50:5173)
APPDOMAIN=http://localhost:5173

# Correo saliente para notificaciones de servicio (opcional: si falta cualquiera
# de estas variables, las notificaciones quedan registradas como "pending" y no
# se envia nada; no rompe el arranque del servidor).
#
# Opcion A - Gmail (rapido para probar, limite bajo): SMTP_HOST=smtp.gmail.com,
#   SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=tu correo, SMTP_PASS= una
#   "contrasena de aplicacion" (no la contrasena normal de la cuenta).
# Opcion B - Resend (recomendado para produccion, requiere dominio verificado):
#   SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_SECURE=false,
#   SMTP_USER=resend, SMTP_PASS= tu API key de Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente que vera el cliente, ej: "CellBits <no-reply@tu-dominio.cl>"
SMTP_FROM=